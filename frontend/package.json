{
  "name": "money-journey-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format:check": "prettier --check src/app src/features src/lib src/components/ui.tsx src/components/Chart.tsx src/components/Filters.tsx src/styles/app.css src/main.tsx *.config.ts tests"
  },
  "dependencies": {
    "@remixicon/react": "^4.6.0",
    "chart.js": "^4.5.1",
    "react": "^19.0.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.4"
  }
}
